{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile & Run Java",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "javac -d \"${workspaceFolder}\" \"${file}\" && java -cp \"${workspaceFolder}\" \"${relativeFileDirname}.${fileBasenameNoExtension}\" < \"${workspaceFolder}\\input.txt\" > \"${workspaceFolder}\\output.txt\""
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": [
                "$javac"
            ]
        }
    ]
}